{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "packages/*/src/**",
      "!**/*.test.*",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/.turbo",
      "!packages/canvas/src/workers/match.generated.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAriaHiddenOnFocusable": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  }
}
