{
  "name": "@remold-ui/dom",
  "version": "0.2.1",
  "description": "Browser layer: reads what is on screen into plain data for the core.",
  "license": "MIT",
  "author": "Albert Dugba",
  "homepage": "https://github.com/albertdugba/remold-ui/tree/main/packages/dom#readme",
  "bugs": {
    "url": "https://github.com/albertdugba/remold-ui/issues"
  },
  "keywords": [
    "morph",
    "animation",
    "transition",
    "flip",
    "text-morph",
    "connectors",
    "dom",
    "view-transitions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertdugba/remold-ui.git",
    "directory": "packages/dom"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --treeshake --splitting",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --treeshake --splitting",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "@remold-ui/core": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "20.14.5"
  }
}
