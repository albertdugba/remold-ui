{
  "name": "@remold-ui/ascii",
  "version": "0.0.0",
  "description": "Live 3D ASCII art on WebGL2: lit words, logos, models, images and webcam drawn as characters, Braille, blocks, halftone or dither.",
  "license": "MIT",
  "author": "Albert Dugba",
  "homepage": "https://github.com/albertdugba/remold-ui/tree/main/packages/ascii#readme",
  "bugs": {
    "url": "https://github.com/albertdugba/remold-ui/issues"
  },
  "keywords": [
    "ascii",
    "ascii-art",
    "webgl",
    "3d",
    "braille",
    "dither",
    "halftone",
    "webcam"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertdugba/remold-ui.git",
    "directory": "packages/ascii"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --treeshake",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --treeshake",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "20.14.5"
  }
}
