{
  "name": "@remold-ui/vue",
  "version": "0.0.0",
  "description": "Vue adapter for Remold.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/albertdugba/remold-ui.git" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external vue",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external vue",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "@remold-ui/dom": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.3"
  },
  "devDependencies": {
    "vue": "3.5.43"
  }
}
