{
  "name": "@remold-ui/core",
  "version": "0.3.0",
  "description": "Headless core: shapes, morphing and matching. No browser APIs.",
  "license": "MIT",
  "author": "Albert Dugba",
  "homepage": "https://github.com/albertdugba/remold-ui/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/albertdugba/remold-ui/issues"
  },
  "keywords": [
    "morph",
    "svg",
    "path",
    "spring",
    "animation",
    "matching",
    "particles",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertdugba/remold-ui.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --treeshake --splitting",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --treeshake --splitting",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {}
}
