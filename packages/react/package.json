{
  "name": "@remold-ui/react",
  "version": "0.1.0",
  "description": "React bindings for Remold: keyless transitions, text morph and canvas scenes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertdugba/remold-ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./canvas": {
      "import": {
        "types": "./dist/canvas.d.ts",
        "default": "./dist/esm/canvas.js"
      },
      "require": {
        "types": "./dist/canvas.d.cts",
        "default": "./dist/canvas.cjs"
      }
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && cp dist/index.d.cts dist/index.d.ts && cp dist/canvas.d.cts dist/canvas.d.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "@remold-ui/canvas": "workspace:*",
    "@remold-ui/core": "workspace:*",
    "@remold-ui/dom": "workspace:*",
    "@remold-ui/morph": "workspace:*",
    "motion": "^14.7.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
