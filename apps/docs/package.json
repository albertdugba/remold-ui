{
  "name": "docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-registry.mjs && next dev --port 5192",
    "build": "node scripts/build-registry.mjs && next build --webpack",
    "start": "next start --port 5192",
    "typecheck": "next typegen && tsc --noEmit",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "clean": "rm -rf .next .source .turbo",
    "registry": "node scripts/build-registry.mjs"
  },
  "dependencies": {
    "@remold-ui/canvas": "workspace:*",
    "@remold-ui/core": "workspace:*",
    "@remold-ui/dom": "workspace:*",
    "@remold-ui/react": "workspace:*",
    "fumadocs-core": "16.17.2",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.2",
    "lucide-react": "1.50.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@opennextjs/cloudflare": "^1.19.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "opentype.js": "2.0.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "^4.152.0"
  }
}
